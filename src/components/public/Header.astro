---
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl" style="background: rgba(5, 5, 5, 0.7); border-bottom: 1px solid var(--color-border-subtle);">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80">
      <img src="/logo.png" alt="SalesAgent" width="120" height="32" style="height: 28px; width: auto;" />
      <span class="hidden text-xs uppercase tracking-[0.18em]" style="color: var(--color-text-tertiary);">Hilfe</span>
    </a>

    <nav class="flex items-center gap-6 text-sm">
      {!isHome && (
        <a href="/" class="hidden sm:inline transition-colors" style="color: var(--color-text-secondary);">Startseite</a>
      )}
      <a href="/kontakt" class="transition-colors hover:text-[var(--color-gold-light)]" style="color: var(--color-text-secondary);">
        Kontakt
      </a>
    </nav>
  </div>
</header>
