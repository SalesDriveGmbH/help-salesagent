---
import ThemeToggle from "./ThemeToggle.astro";
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<header class="glass-bar sticky top-0 z-40 w-full">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80">
      <img src="/logo.png" alt="SalesAgent" width="120" height="32" decoding="async" fetchpriority="high" style="height: 28px; width: auto;" class="logo-img" />
      <span class="hidden text-xs uppercase tracking-[0.18em] sm:inline" style="color: var(--color-text-tertiary);">Hilfe</span>
    </a>

    <nav class="flex items-center gap-3 text-sm sm:gap-5">
      {!isHome && (
        <a href="/" class="hidden sm:inline transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">Startseite</a>
      )}
      <a href="/kontakt" class="transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">
        Kontakt
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  /* Logo invertieren in Light-Mode (Logo ist Weiß-Version) */
  :root[data-theme="light"] .logo-img {
    filter: invert(1) hue-rotate(180deg) brightness(0.85);
  }
  /* Subtler Gold-Shimmer beim ersten Sichtbarwerden */
  .logo-img {
    animation: logo-shimmer 1400ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes logo-shimmer {
    0% { opacity: 0; transform: translateY(-4px); }
    50% { filter: brightness(1.4) drop-shadow(0 0 12px rgba(191, 163, 124, 0.4)); }
    100% { opacity: 1; transform: translateY(0); filter: none; }
  }
  :root[data-theme="light"] .logo-img {
    animation: logo-shimmer-light 1400ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes logo-shimmer-light {
    0% { opacity: 0; transform: translateY(-4px); filter: invert(1) hue-rotate(180deg) brightness(0.85); }
    50% { filter: invert(1) hue-rotate(180deg) brightness(0.95) drop-shadow(0 0 12px rgba(155, 127, 79, 0.4)); }
    100% { opacity: 1; transform: translateY(0); filter: invert(1) hue-rotate(180deg) brightness(0.85); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-img { animation: none; }
  }
</style>
