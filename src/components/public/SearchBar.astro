---
interface Props {
  size?: "lg" | "md";
  placeholder?: string;
}

const { size = "md", placeholder = "Was möchtest du wissen?" } = Astro.props;
const isLg = size === "lg";
---

<button
  type="button"
  data-search-trigger
  class={`search-trigger group relative flex w-full items-center gap-3 rounded-md border text-left transition-all ${isLg ? "h-14 px-5 text-base" : "h-11 px-4 text-sm"}`}
  aria-label="Suche öffnen (⌘K)"
>
  <svg width={isLg ? 20 : 18} height={isLg ? 20 : 18} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-text-tertiary);">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m21 21-4.35-4.35"></path>
  </svg>
  <span class="flex-1 truncate" style="color: var(--color-text-tertiary);">{placeholder}</span>
  <span class="hidden items-center gap-1 sm:flex">
    <kbd class="rounded border px-1.5 py-0.5 font-mono text-[11px]" style="border-color: var(--color-border-default); color: var(--color-text-tertiary);">⌘K</kbd>
  </span>
</button>

<style>
  .search-trigger {
    background: color-mix(in srgb, var(--color-bg-elevated) 80%, transparent);
    border-color: var(--color-border-subtle);
    cursor: pointer;
  }
  .search-trigger:hover {
    border-color: var(--color-border-default);
    background: color-mix(in srgb, var(--color-bg-elevated) 95%, transparent);
  }
  :root[data-theme="light"] .search-trigger { background: #FFFFFF; border-color: var(--color-border-default); }
  :root[data-theme="light"] .search-trigger:hover { background: #FFFFFF; border-color: var(--color-border-strong); }
</style>

<script>
  document.querySelectorAll("[data-search-trigger]").forEach((el) => {
    el.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("palette:open"));
    });
  });
</script>
