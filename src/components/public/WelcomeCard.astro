---
---
<div id="welcome-card" class="welcome-card" hidden>
  <button class="welcome-card__close" data-welcome-close type="button" aria-label="Schließen">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <div class="welcome-card__inner">
    <div class="flex items-center gap-2">
      <span class="welcome-card__dot" aria-hidden="true"></span>
      <span class="text-[10px] uppercase tracking-[0.18em]" style="color: var(--color-gold-bright);">Willkommen</span>
    </div>
    <h3 class="mt-3 text-2xl font-semibold" style="color: var(--color-text-primary); letter-spacing: -0.025em;">Schön, dass du da bist.</h3>
    <p class="mt-3 text-sm" style="color: var(--color-text-secondary); line-height: 1.55;">
      Wir helfen dir hier in 3 Wegen weiter:
    </p>
    <ul class="mt-4 space-y-2.5 text-sm" style="color: var(--color-text-secondary);">
      <li class="flex items-start gap-3">
        <kbd class="welcome-kbd">⌘K</kbd>
        <span>Schnell-Suche durch alle Artikel</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="welcome-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/>
          </svg>
        </span>
        <span><strong style="color: var(--color-text-primary);">Sandy</strong> — frag die AI direkt unten rechts</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="welcome-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
        </span>
        <span>Artikel mit dem Stern merken</span>
      </li>
    </ul>
    <div class="mt-5 flex flex-wrap gap-2">
      <button class="welcome-card__primary" data-welcome-close data-welcome-tour type="button">
        Kurze Tour zeigen
      </button>
      <button class="welcome-card__secondary" data-welcome-close type="button">
        Selbst entdecken
      </button>
    </div>
  </div>
</div>

<style>
  .welcome-card {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 35;
    width: 320px;
    max-width: calc(100vw - 32px);
    border-radius: 12px;
    border: 1px solid var(--color-border-default);
    background: color-mix(in srgb, var(--color-bg-elevated) 95%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 24px 60px -16px rgba(0, 0, 0, 0.5);
    animation: welcome-pop 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 1200ms;
  }
  :root[data-theme="light"] .welcome-card {
    background: #FFFFFF;
    box-shadow: 0 24px 60px -16px rgba(26, 22, 18, 0.20);
  }
  @keyframes welcome-pop {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .welcome-card[hidden] { display: none; }
  .welcome-card__inner { padding: 18px 20px 18px; }
  .welcome-card__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 0;
    background: transparent;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: all 160ms ease;
  }
  .welcome-card__close:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-hover);
  }
  .welcome-card__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold-primary);
    box-shadow: 0 0 0 0 rgba(191, 163, 124, 0.6);
    animation: recent-pulse 2.4s ease-in-out infinite;
  }
  .welcome-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 22px;
    padding: 0 0.45rem;
    border-radius: 5px;
    border: 1px solid var(--color-border-default);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-bg-base) 60%, transparent);
  }
  .welcome-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-gold-bright);
  }
  .welcome-card__primary, .welcome-card__secondary {
    font-size: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-radius: 7px;
    cursor: pointer;
    border: 1px solid;
    transition: all 200ms ease;
  }
  .welcome-card__primary {
    background: var(--color-gold-primary);
    color: #FFFFFF;
    border-color: var(--color-gold-primary);
  }
  :root:not([data-theme="light"]) .welcome-card__primary { color: #050505; }
  .welcome-card__primary:hover {
    background: var(--color-gold-bright);
    border-color: var(--color-gold-bright);
  }
  .welcome-card__secondary {
    background: transparent;
    color: var(--color-text-secondary);
    border-color: var(--color-border-default);
  }
  .welcome-card__secondary:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }
  @media (max-width: 640px) {
    .welcome-card {
      left: 16px;
      right: 16px;
      bottom: 96px; /* Platz für Floating Sandy-Button */
      width: auto;
    }
    .welcome-card__inner { padding: 16px; }
  }
</style>

<script>
  const SEEN_KEY = "sd:welcomed";
  const card = document.getElementById("welcome-card") as HTMLElement | null;
  if (card && !localStorage.getItem(SEEN_KEY)) {
    card.removeAttribute("hidden");
  }
  document.querySelectorAll("[data-welcome-close]").forEach((b) => {
    b.addEventListener("click", () => {
      try { localStorage.setItem(SEEN_KEY, "1"); } catch {}
      card?.setAttribute("hidden", "");
      if ((b as HTMLElement).hasAttribute("data-welcome-tour")) {
        window.dispatchEvent(new CustomEvent("onboarding:start"));
      }
    });
  });
</script>
