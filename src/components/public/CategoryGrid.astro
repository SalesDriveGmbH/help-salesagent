---
import { CATEGORIES } from "../../lib/categories";
import { getCollection } from "astro:content";

const all = await getCollection("articles");
const counts: Record<string, number> = {};
for (const a of all) counts[a.data.category] = (counts[a.data.category] ?? 0) + 1;

const ICONS: Record<string, string> = {
  Euro: `<path d="M4 10h12M4 14h9"/><path d="M19 6.5A8 8 0 1 0 19 17.5"/>`,
  Settings: `<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/>`,
  Briefcase: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
  FileText: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>`,
  BookOpen: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  Users: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
};
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {CATEGORIES.map((cat) => (
    <a href={`/kategorie/${cat.slug}`} class="card group block p-6 transition-transform hover:translate-y-[-1px]">
      <div class="flex items-start justify-between">
        <div class="rounded-lg p-2.5" style="background: rgba(191, 163, 124, 0.08); border: 1px solid var(--color-border-subtle);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold-primary);" set:html={ICONS[cat.icon]} />
        </div>
        <span class="text-xs" style="color: var(--color-text-tertiary);">{counts[cat.slug] ?? 0} Artikel</span>
      </div>
      <h3 class="mt-5 text-lg font-semibold transition-colors group-hover:text-[var(--color-gold-light)]" style="color: var(--color-text-primary); letter-spacing: -0.02em;">
        {cat.title}
      </h3>
      <p class="mt-2 text-sm" style="color: var(--color-text-secondary);">{cat.description}</p>
    </a>
  ))}
</div>
