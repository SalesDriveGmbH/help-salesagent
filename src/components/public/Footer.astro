---
---
<footer class="relative z-10 mt-24 border-t" style="border-color: var(--color-border-subtle);">
  <div class="mx-auto max-w-6xl px-6 py-12 pb-28 sm:pb-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <img src="/logo.png" alt="SalesAgent" width="120" height="32" loading="lazy" decoding="async" style="height: 22px; width: auto; opacity: 0.85;" class="logo-img" />
        <p class="mt-4 text-xs leading-relaxed" style="color: var(--color-text-tertiary); max-width: 220px;">
          Der Hilfebereich für SalesAgents bei SalesDrive.
        </p>
      </div>

      <div>
        <div class="text-[10px] uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Direkt-Links</div>
        <ul class="mt-3 space-y-1.5 text-sm">
          <li><a href="/" class="transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">Startseite</a></li>
          <li><a href="/lesezeichen" class="transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">Meine Lesezeichen</a></li>
          <li><a href="/glossar" class="transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">Glossar</a></li>
          <li><a href="/kontakt" class="transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">Kontakt</a></li>
        </ul>
      </div>

      <div>
        <div class="text-[10px] uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Direkter Draht</div>
        <ul class="mt-3 space-y-1.5 text-sm">
          <li><a href="mailto:office@salesagent.at" class="font-mono transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">office@salesagent.at</a></li>
          <li class="text-xs" style="color: var(--color-text-tertiary);">Mo – Fr · 09:00 – 17:00 CET</li>
          <li class="text-xs" style="color: var(--color-text-tertiary);">Antwort innerhalb 24 h</li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t pt-5 text-xs sm:flex-row sm:items-center" style="border-color: var(--color-border-subtle); color: var(--color-text-tertiary);">
      <div>© {new Date().getFullYear()} SalesAgent — alle Rechte vorbehalten.</div>
      <div class="flex flex-wrap items-center gap-5">
        <button type="button" id="rerun-tour" class="transition-colors hover:text-[var(--color-gold-bright)]" style="background: transparent; border: 0; cursor: pointer; color: inherit; padding: 0;">Tour erneut starten</button>
        <a href="https://salesagent.at/impressum" class="transition-colors hover:text-[var(--color-gold-bright)]" rel="noopener">Impressum</a>
        <a href="https://salesagent.at/datenschutz" class="transition-colors hover:text-[var(--color-gold-bright)]" rel="noopener">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById("rerun-tour")?.addEventListener("click", () => {
    try { localStorage.removeItem("sd:onboarded"); } catch {}
    window.dispatchEvent(new CustomEvent("onboarding:start"));
  });
</script>

<style>
  :root[data-theme="light"] .logo-img {
    filter: invert(1) hue-rotate(180deg) brightness(0.85);
  }
</style>
