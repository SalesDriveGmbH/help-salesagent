---
---
<footer class="relative z-10 mt-24 border-t" style="border-color: var(--color-border-subtle);">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="SalesAgent" style="height: 24px; width: auto; opacity: 0.85;" />
        </div>
        <p class="mt-4 max-w-sm text-sm" style="color: var(--color-text-secondary);">
          Der zentrale Hilfebereich für SalesAgents der SalesDrive GmbH. Alles, was du als SalesAgent wissen musst.
        </p>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Kontakt</h4>
        <ul class="mt-3 space-y-1.5 text-sm" style="color: var(--color-text-secondary);">
          <li><a href="mailto:office@salesdrive.at" class="hover:text-[var(--color-gold-light)]">office@salesdrive.at</a></li>
          <li><a href="mailto:accounting@salesdrive.at" class="hover:text-[var(--color-gold-light)]">accounting@salesdrive.at</a></li>
          <li>+43 (0) 676 7951018</li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Geschäftszeiten</h4>
        <ul class="mt-3 space-y-1.5 text-sm" style="color: var(--color-text-secondary);">
          <li>Mo – Fr</li>
          <li>09:00 – 17:00 CET</li>
          <li class="text-xs" style="color: var(--color-text-tertiary);">Antwort innerhalb 24h</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t pt-6 text-xs sm:flex-row sm:items-center" style="border-color: var(--color-border-subtle); color: var(--color-text-tertiary);">
      <div>© {new Date().getFullYear()} SalesDrive GmbH · Wien · Geschäftsführer: Alexander Kiraly</div>
      <div class="flex items-center gap-5">
        <a href="https://salesdrive.at/impressum" class="hover:text-[var(--color-gold-light)]" rel="noopener">Impressum</a>
        <a href="https://salesdrive.at/datenschutz" class="hover:text-[var(--color-gold-light)]" rel="noopener">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
