---
---
<footer class="relative z-10 mt-24 border-t" style="border-color: var(--color-border-subtle);">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="SalesAgent" width="120" height="32" loading="lazy" decoding="async" style="height: 22px; width: auto; opacity: 0.85;" class="logo-img" />
      </div>

      <div class="flex flex-col items-start gap-1 text-sm sm:items-end">
        <a href="mailto:office@salesagent.at" class="font-mono transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-secondary);">office@salesagent.at</a>
        <span class="text-xs" style="color: var(--color-text-tertiary);">Mo – Fr · 09:00 – 17:00 CET</span>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t pt-5 text-xs sm:flex-row sm:items-center" style="border-color: var(--color-border-subtle); color: var(--color-text-tertiary);">
      <div>© {new Date().getFullYear()} SalesAgent — alle Rechte vorbehalten.</div>
      <div class="flex items-center gap-5">
        <a href="https://salesagent.at/impressum" class="transition-colors hover:text-[var(--color-gold-bright)]" rel="noopener">Impressum</a>
        <a href="https://salesagent.at/datenschutz" class="transition-colors hover:text-[var(--color-gold-bright)]" rel="noopener">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<style>
  :root[data-theme="light"] .logo-img {
    filter: invert(1) hue-rotate(180deg) brightness(0.85);
  }
</style>
