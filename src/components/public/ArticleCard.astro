---
import StatusBadge from "./StatusBadge.astro";

interface Props {
  href: string;
  id: string;
  title: string;
  tldr?: string;
  status: "complete" | "partial" | "todo";
  variant?: "compact" | "default";
}

const { href, id, title, tldr, status, variant = "default" } = Astro.props;
---

<a href={href} class="card group block p-5 transition-transform hover:translate-y-[-1px]">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">
      <span>{id}</span>
    </div>
    {status !== "complete" && <StatusBadge status={status} />}
  </div>
  <h3 class={`mt-2 font-semibold transition-colors group-hover:text-[var(--color-gold-light)] ${variant === "compact" ? "text-base" : "text-lg"}`} style="color: var(--color-text-primary); letter-spacing: -0.02em;">
    {title}
  </h3>
  {tldr && (
    <p class="mt-2 text-sm" style="color: var(--color-text-secondary);">{tldr}</p>
  )}
  <div class="mt-4 flex items-center text-xs" style="color: var(--color-text-tertiary);">
    Lesen
    <svg class="ml-1 transition-transform group-hover:translate-x-0.5" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 5l7 7-7 7"/>
    </svg>
  </div>
</a>
