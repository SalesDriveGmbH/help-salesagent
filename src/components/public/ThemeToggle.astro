---
---

<div class="theme-picker" data-theme-picker>
  <button class="theme-picker__trigger" type="button" aria-label="Theme wechseln" aria-haspopup="menu" aria-expanded="false">
    <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg class="theme-icon-system" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
    </svg>
  </button>
  <div class="theme-picker__menu" role="menu">
    <button class="theme-picker__option" data-theme-set="system" role="menuitem">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      <span>System</span>
      <span class="theme-picker__check">✓</span>
    </button>
    <button class="theme-picker__option" data-theme-set="light" role="menuitem">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <span>Hell</span>
      <span class="theme-picker__check">✓</span>
    </button>
    <button class="theme-picker__option" data-theme-set="dark" role="menuitem">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span>Dunkel</span>
      <span class="theme-picker__check">✓</span>
    </button>
  </div>
</div>

<style>
  .theme-picker { position: relative; display: inline-block; }
  .theme-picker__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    width: 32px;
    border-radius: 8px;
    border: 1px solid var(--color-border-subtle);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .theme-picker__trigger:hover {
    color: var(--color-gold-bright);
    border-color: var(--color-border-default);
    background: var(--color-bg-hover);
  }
  .theme-icon-sun, .theme-icon-moon, .theme-icon-system { display: none; }
  :root[data-theme="dark"] .theme-picker__trigger .theme-icon-sun { display: block; }
  :root[data-theme="light"] .theme-picker__trigger .theme-icon-moon { display: block; }

  .theme-picker__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 160px;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--color-border-default);
    background: color-mix(in srgb, var(--color-bg-elevated) 96%, transparent);
    box-shadow: 0 18px 48px -12px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    transform-origin: top right;
    pointer-events: none;
    transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 60;
  }
  :root[data-theme="light"] .theme-picker__menu { background: #FFFFFF; box-shadow: 0 18px 48px -12px rgba(26, 22, 18, 0.18); }
  .theme-picker.is-open .theme-picker__menu {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .theme-picker__option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    border: 0;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }
  .theme-picker__option:hover {
    background: color-mix(in srgb, var(--color-gold-primary) 10%, transparent);
    color: var(--color-text-primary);
  }
  .theme-picker__option > span:first-of-type { flex: 1; text-align: left; }
  .theme-picker__check {
    font-size: 0.85rem;
    color: var(--color-gold-bright);
    opacity: 0;
  }
  .theme-picker__option[data-active="true"] .theme-picker__check { opacity: 1; }
  .theme-picker__option[data-active="true"] { color: var(--color-text-primary); }
</style>

<script>
  type Mode = "system" | "light" | "dark";
  const STORAGE_KEY = "sd-theme-mode";

  function resolved(mode: Mode): "light" | "dark" {
    if (mode === "system") {
      return window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    }
    return mode;
  }

  function load(): Mode {
    try {
      const v = localStorage.getItem(STORAGE_KEY) as Mode | null;
      if (v === "system" || v === "light" || v === "dark") return v;
      // Migration vom alten Schlüssel "sd-theme"
      const old = localStorage.getItem("sd-theme");
      if (old === "light" || old === "dark") return old;
    } catch {}
    return "system";
  }

  function apply(mode: Mode) {
    const r = resolved(mode);
    document.documentElement.setAttribute("data-theme", r);
    try { localStorage.setItem(STORAGE_KEY, mode); } catch {}
    syncMenu(mode);
  }

  function syncMenu(mode: Mode) {
    document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => {
      b.dataset.active = String(b.dataset.themeSet === mode);
    });
  }

  // Initial apply (pre-paint script setzt schon "dark"/"light", aber wir
  // korrigieren auf System falls so gespeichert)
  const initial = load();
  apply(initial);

  // System-Watcher
  if (window.matchMedia) {
    const mq = window.matchMedia("(prefers-color-scheme: light)");
    mq.addEventListener?.("change", () => {
      if (load() === "system") apply("system");
    });
  }

  const pickers = document.querySelectorAll<HTMLElement>("[data-theme-picker]");
  pickers.forEach((picker) => {
    const trigger = picker.querySelector<HTMLButtonElement>(".theme-picker__trigger")!;
    const options = picker.querySelectorAll<HTMLElement>("[data-theme-set]");

    function open() {
      picker.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
    }
    function close() {
      picker.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    }

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      if (picker.classList.contains("is-open")) close();
      else open();
    });

    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        const m = opt.dataset.themeSet as Mode;
        apply(m);
        close();
      });
    });

    document.addEventListener("click", (e) => {
      if (!picker.contains(e.target as Node)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  });
</script>
