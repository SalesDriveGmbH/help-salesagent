---
import "../styles/global.css";
import Header from "../components/public/Header.astro";
import Footer from "../components/public/Footer.astro";
import GrainOverlay from "../components/public/GrainOverlay.astro";
import WelcomeCard from "../components/public/WelcomeCard.astro";
import OnboardingTour from "../components/public/OnboardingTour.astro";

interface Props {
  title: string;
  description?: string;
  hideChat?: boolean;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Hilfebereich für SalesAgents von SalesDrive — Antworten zu Abrechnung, Onboarding, Verträgen, Tools.",
  hideChat = false,
  ogType = "website",
} = Astro.props;

const fullTitle = title.includes("SalesAgent Hilfe") ? title : `${title} — SalesAgent Hilfe`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://help.salesagent.at").toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/logo.png" as="image" fetchpriority="high" />
    <link rel="canonical" href={canonical} />
    <meta name="view-transition" content="same-origin" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#050505" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAF7F0" media="(prefers-color-scheme: light)" />
    <meta name="format-detection" content="telephone=no" />
    <title>{fullTitle}</title>

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SalesAgent Hilfe" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:image" content="/og-image.svg" />
    {/* Twitter Card */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (function () {
        try {
          var mode = localStorage.getItem("sd-theme-mode");
          if (mode !== "system" && mode !== "light" && mode !== "dark") {
            var legacy = localStorage.getItem("sd-theme");
            mode = (legacy === "light" || legacy === "dark") ? legacy : "system";
          }
          var sysLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
          var theme = mode === "system" ? (sysLight ? "light" : "dark") : mode;
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body class="relative">
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <div class="aurora" aria-hidden="true"></div>
    <GrainOverlay />
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main id="main-content" class="flex-1" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <div id="palette-mount"></div>
    {!hideChat && (
      <>
        <WelcomeCard />
        <OnboardingTour />
      </>
    )}
    {!hideChat && (
      <>
        <button
          id="sandy-trigger-shell"
          type="button"
          aria-label="Chat mit Sandy öffnen"
          class="sandy-trigger fixed bottom-6 right-6 z-40 flex items-center gap-2 rounded-full px-5 py-3 text-sm font-medium"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold-bright);">
            <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z" />
          </svg>
          Frag Sandy
        </button>
        <div id="chat-mount" data-chat-widget></div>
      </>
    )}
    <script is:inline>
      // ── Aurora folgt subtil der Maus ─────────────────────────────────
      (function () {
        const aurora = document.querySelector(".aurora");
        if (!aurora || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        let pending = false;
        window.addEventListener("pointermove", (e) => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => {
            const mx = e.clientX / window.innerWidth;
            const my = e.clientY / window.innerHeight;
            aurora.style.setProperty("--mx", String(mx));
            aurora.style.setProperty("--my", String(my));
            pending = false;
          });
        }, { passive: true });
      })();
    </script>

    <script>
      // ── Scroll-Reveal via IntersectionObserver ──────────────────────────
      (function () {
        const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!targets.length || !("IntersectionObserver" in window)) {
          targets.forEach((t) => t.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });
        targets.forEach((t) => io.observe(t));
      })();

      // ── Command Palette lazy mount ──────────────────────────────────────
      const paletteTarget = document.getElementById("palette-mount");
      let paletteMounted = false;
      function mountPalette(openImmediately = false) {
        if (paletteMounted || !paletteTarget) return Promise.resolve();
        paletteMounted = true;
        return import("../components/public/CommandPalette").then(({ mountCommandPalette }) => {
          mountCommandPalette(paletteTarget);
          if (openImmediately) requestAnimationFrame(() => window.dispatchEvent(new CustomEvent("palette:open")));
        });
      }
      // Hotkey listener bevor Palette geladen ist
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (!paletteMounted) mountPalette(true);
          else window.dispatchEvent(new CustomEvent("palette:open"));
        }
      });
      window.addEventListener("palette:open", () => { if (!paletteMounted) mountPalette(true); });
      window.addEventListener("palette:open-with-query", (e) => {
        if (!paletteMounted) {
          mountPalette(false).then(() => {
            requestAnimationFrame(() => window.dispatchEvent(new CustomEvent("palette:open-with-query", { detail: (e as CustomEvent).detail })));
          });
        }
      });
      // Im Hintergrund vorladen
      if ("requestIdleCallback" in window) requestIdleCallback(() => mountPalette(false), { timeout: 4000 });
      else setTimeout(() => mountPalette(false), 2000);

      // ── ChatWidget lazy mount ──────────────────────────────────────────
      const target = document.getElementById("chat-mount");
      const shell = document.getElementById("sandy-trigger-shell");
      let mounted = false;

      function mount(openImmediately = false) {
        if (mounted || !target) return;
        mounted = true;
        if (shell) shell.style.display = "none";
        return import("../components/public/ChatWidget").then(({ mountChatWidget }) => {
          mountChatWidget(target);
          if (openImmediately) {
            window.dispatchEvent(new CustomEvent("sandy:open"));
          }
        });
      }

      if (shell) {
        shell.addEventListener("click", () => mount(true), { once: true });
      }

      // Auch reagieren wenn andere Buttons auf der Seite das Chat-Event feuern
      window.addEventListener("sandy:open", () => mount(true), { once: true });

      // Im Hintergrund vorladen wenn der Browser idle ist (max nach 3 s)
      const lazyLoad = () => mount(false);
      if ("requestIdleCallback" in window) {
        requestIdleCallback(lazyLoad, { timeout: 3000 });
      } else {
        setTimeout(lazyLoad, 1500);
      }
    </script>
  </body>
</html>
