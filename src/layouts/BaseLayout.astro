---
import "../styles/global.css";
import Header from "../components/public/Header.astro";
import Footer from "../components/public/Footer.astro";
import GrainOverlay from "../components/public/GrainOverlay.astro";

interface Props {
  title: string;
  description?: string;
  hideChat?: boolean;
}

const {
  title,
  description = "Hilfebereich für SalesAgents von SalesDrive — Antworten zu Abrechnung, Onboarding, Verträgen, Tools.",
  hideChat = false,
} = Astro.props;

const fullTitle = title.includes("SalesAgent Hilfe") ? title : `${title} — SalesAgent Hilfe`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <title>{fullTitle}</title>
  </head>
  <body class="relative">
    <div class="aurora" aria-hidden="true"></div>
    <GrainOverlay />
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    {!hideChat && (
      <div id="chat-mount" data-chat-widget></div>
    )}
    <script>
      // Lazy-mount des ChatWidgets nur wenn sichtbar
      const target = document.getElementById("chat-mount");
      if (target) {
        import("../components/public/ChatWidget").then(({ mountChatWidget }) => {
          mountChatWidget(target);
        });
      }
    </script>
  </body>
</html>
