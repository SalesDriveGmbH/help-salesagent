---
import BaseLayout from "./BaseLayout.astro";
import StatusBadge from "../components/public/StatusBadge.astro";
import { getCategory } from "../lib/categories";
import { GLOSSARY } from "../lib/glossary";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const category = getCategory(data.category);

const all = await getCollection("articles");
const related = (data.related ?? [])
  .map((id) => all.find((a) => a.data.id === id))
  .filter(Boolean) as CollectionEntry<"articles">[];

const h2Headings = headings.filter((h) => h.depth === 2);

// Lesezeit aus Body: ~ 200 WPM Deutsch
const wordCount = ((entry.body ?? "").match(/\b\w+\b/g) ?? []).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout title={data.title} description={data.tldr ?? data.title}>
  <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
  <article class="mx-auto max-w-6xl px-6 pb-24 pt-10">
    <nav class="mb-8 flex items-center gap-2 text-xs" style="color: var(--color-text-tertiary);" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-[var(--color-gold-bright)]">Hilfe</a>
      <span>/</span>
      <a href={`/kategorie/${data.category}`} class="hover:text-[var(--color-gold-bright)]">{category?.title}</a>
      <span>/</span>
      <span style="color: var(--color-text-secondary);">{data.id}</span>
    </nav>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_220px]">
      <div class="min-w-0">
        <header class="reveal">
          <div class="flex flex-wrap items-center gap-3 text-xs" style="color: var(--color-text-tertiary);">
            <span class="font-mono">{data.id}</span>
            <StatusBadge status={data.status} />
            <span>·</span>
            <span>{readingMinutes} Min. Lesezeit</span>
            <span>·</span>
            <span>aktualisiert {data.last_updated}</span>
            <div class="ml-auto flex items-center gap-1.5">
              <button class="article-icon-btn" data-share={data.title} aria-label="Teilen" title="Teilen">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
              </button>
              <button class="article-icon-btn article-bookmark" data-bookmark={data.id} aria-label="Merken" title="Merken">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                </svg>
              </button>
            </div>
          </div>
          <h1 class="article-headline mt-4" style="color: var(--color-text-primary);" data-pagefind-meta="title">
            {data.title}
          </h1>
          {data.tldr && (
            <p class="mt-4 max-w-2xl text-base" style="color: var(--color-text-secondary);">
              {data.tldr}
            </p>
          )}
        </header>

        {data.status !== "complete" && (
          <aside class="mt-8 rounded-md border p-5" style="border-color: var(--color-border-default); background: rgba(191, 163, 124, 0.05);">
            <div class="flex items-start gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold-bright); margin-top: 2px;">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
              <div class="flex-1 text-sm">
                <strong style="color: var(--color-gold-bright);">
                  {data.status === "partial" ? "Dieser Artikel ist noch in Bearbeitung." : "Dieser Artikel wird gerade erstellt."}
                </strong>
                <p class="mt-1" style="color: var(--color-text-secondary);">
                  Einzelne Angaben werden noch finalisiert. Bei dringenden Fragen direkt im Chat eskalieren oder an
                  <a href={`mailto:${data.escalate_to ?? "office@salesagent.at"}`} class="underline" style="color: var(--color-gold-light);">{data.escalate_to ?? "office@salesagent.at"}</a> schreiben.
                </p>
                <button data-open-chat class="btn btn-ghost mt-3" type="button">
                  Mit Sandy chatten
                </button>
              </div>
            </div>
          </aside>
        )}

        <div
          class="prose-gold mt-10"
          data-pagefind-body
        >
          <Content />
        </div>

        <section class="mt-14 rounded-md border p-5" style="border-color: var(--color-border-subtle); background: rgba(14, 14, 14, 0.5);">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm" style="color: var(--color-text-secondary);">War dieser Artikel hilfreich?</p>
            <div class="flex gap-2">
              <button class="btn btn-ghost" data-feedback="yes" type="button">Ja</button>
              <button class="btn btn-ghost" data-feedback="no" type="button">Nein</button>
            </div>
          </div>
          <div id="feedback-msg" class="mt-3 hidden text-sm" style="color: var(--color-gold-light);"></div>
        </section>

        {related.length > 0 && (
          <section class="mt-14">
            <h2 class="h-display text-xl" style="color: var(--color-text-primary); letter-spacing: -0.03em;">
              Verwandte Artikel
            </h2>
            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {related.slice(0, 4).map((r) => {
                const slug = r.id.replace(/^[^/]+\//, "");
                return (
                  <a href={`/artikel/${r.data.category}/${slug}`} class="card group block p-4 transition-transform hover:translate-y-[-1px]">
                    <div class="text-xs" style="color: var(--color-text-tertiary);">{r.data.id}</div>
                    <div class="mt-1 text-sm font-medium transition-colors group-hover:text-[var(--color-gold-light)]" style="color: var(--color-text-primary);">{r.data.title}</div>
                  </a>
                );
              })}
            </div>
          </section>
        )}
      </div>

      <aside class="hidden lg:block">
        {h2Headings.length > 0 && (
          <div class="sticky top-24" id="article-toc">
            <div class="text-xs uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Inhalt</div>
            <ul class="mt-4 space-y-0.5 text-sm">
              {h2Headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug} class="toc-link block py-1 transition-colors" style="color: var(--color-text-secondary);">
                    <span class="toc-bar"></span>
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>

  <script is:inline define:vars={{ glossary: GLOSSARY }}>
    // ── Glossar-Tooltips ────────────────────────────────────────────────
    // Wir gehen durch alle Text-Knoten im prose-gold-Container und wrappen
    // Glossar-Begriffe in <abbr> mit data-glossary.
    (function () {
      const prose = document.querySelector(".prose-gold");
      if (!prose) return;
      const terms = Object.keys(glossary).sort((a, b) => b.length - a.length);
      const pattern = new RegExp("\\b(" + terms.map((t) => t.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&")).join("|") + ")\\b", "g");
      function walk(node) {
        if (node.nodeType === Node.TEXT_NODE) {
          if (!pattern.test(node.nodeValue)) return;
          pattern.lastIndex = 0;
          const frag = document.createDocumentFragment();
          let last = 0;
          let m;
          while ((m = pattern.exec(node.nodeValue)) !== null) {
            if (m.index > last) frag.appendChild(document.createTextNode(node.nodeValue.slice(last, m.index)));
            const span = document.createElement("abbr");
            span.className = "glossary-term";
            span.setAttribute("data-glossary", m[0]);
            span.setAttribute("title", glossary[m[0]]);
            span.textContent = m[0];
            frag.appendChild(span);
            last = m.index + m[0].length;
          }
          if (last < node.nodeValue.length) frag.appendChild(document.createTextNode(node.nodeValue.slice(last)));
          node.parentNode.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const tag = node.tagName.toLowerCase();
          if (["code", "pre", "a", "abbr", "script", "style"].includes(tag)) return;
          // Kopie der ChildNodes, damit replaceChild im Loop nicht verrutscht
          Array.from(node.childNodes).forEach(walk);
        }
      }
      walk(prose);
    })();
  </script>

  <script>
    // ── Scroll-Spy für Inhaltsverzeichnis ───────────────────────────────
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    if (tocLinks.length > 0) {
      const headings = tocLinks
        .map((link) => {
          const id = link.dataset.tocLink!;
          const el = document.getElementById(id);
          return el ? { id, el, link } : null;
        })
        .filter(Boolean) as Array<{ id: string; el: HTMLElement; link: HTMLAnchorElement }>;

      let activeId = "";
      function setActive(id: string) {
        if (id === activeId) return;
        activeId = id;
        tocLinks.forEach((l) => l.classList.toggle("is-active", l.dataset.tocLink === id));
      }

      function onScrollSpy() {
        const offset = 120; // Header + Atem
        let current = headings[0]?.id ?? "";
        for (const h of headings) {
          if (h.el.getBoundingClientRect().top - offset <= 0) current = h.id;
          else break;
        }
        setActive(current);
      }
      window.addEventListener("scroll", onScrollSpy, { passive: true });
      onScrollSpy();
    }

    // ── Lesefortschritt-Bar ─────────────────────────────────────────────
    const bar = document.getElementById("reading-progress");
    if (bar) {
      const article = document.querySelector("article");
      function update() {
        if (!article) return;
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const passed = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        const pct = total > 0 ? (passed / total) * 100 : 0;
        bar.style.transform = `scaleX(${pct / 100})`;
      }
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    }

    // ── Bookmarks via localStorage ──────────────────────────────────────
    const BOOKMARK_KEY = "sd:bookmarks";
    function getBookmarks(): string[] {
      try { return JSON.parse(localStorage.getItem(BOOKMARK_KEY) ?? "[]"); } catch { return []; }
    }
    function setBookmarks(arr: string[]) {
      try { localStorage.setItem(BOOKMARK_KEY, JSON.stringify(arr)); } catch {}
    }
    document.querySelectorAll<HTMLElement>("[data-bookmark]").forEach((btn) => {
      const id = btn.dataset.bookmark!;
      const sync = () => {
        const has = getBookmarks().includes(id);
        btn.classList.toggle("is-active", has);
        btn.setAttribute("title", has ? "Gemerkt — entfernen" : "Merken");
      };
      sync();
      btn.addEventListener("click", () => {
        const arr = getBookmarks();
        const next = arr.includes(id) ? arr.filter((x) => x !== id) : [id, ...arr].slice(0, 50);
        setBookmarks(next);
        sync();
      });
    });

    // ── Share + Copy-Link ───────────────────────────────────────────────
    function showToast(text: string) {
      let toast = document.getElementById("share-toast");
      if (!toast) {
        toast = document.createElement("div");
        toast.id = "share-toast";
        toast.className = "share-toast";
        document.body.appendChild(toast);
      }
      toast.textContent = text;
      requestAnimationFrame(() => toast!.classList.add("is-visible"));
      setTimeout(() => toast!.classList.remove("is-visible"), 1800);
    }

    document.querySelectorAll<HTMLElement>("[data-share]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const title = btn.dataset.share ?? document.title;
        const url = window.location.href;
        // Native share auf Mobile
        if (navigator.share && /Mobi|Android|iPhone/i.test(navigator.userAgent)) {
          try { await navigator.share({ title, url }); return; } catch { /* user canceled */ }
        }
        try {
          await navigator.clipboard.writeText(url);
          btn.classList.add("is-flash");
          setTimeout(() => btn.classList.remove("is-flash"), 800);
          showToast("Link kopiert");
        } catch {
          showToast("Kopieren fehlgeschlagen — manuell aus der Adresszeile");
        }
      });
    });

    // ── Zuletzt-gelesen tracken (für Command Palette) ──────────────────
    try {
      const ID = document.querySelector("[data-bookmark]")?.getAttribute("data-bookmark");
      if (ID) {
        const RECENT_KEY = "sd:recent-articles";
        const prev = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]") as string[];
        const next = [ID, ...prev.filter((x) => x !== ID)].slice(0, 5);
        localStorage.setItem(RECENT_KEY, JSON.stringify(next));
      }
    } catch {}

    // ── Feedback ────────────────────────────────────────────────────────
    document.querySelectorAll("[data-feedback]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const value = (btn as HTMLElement).dataset.feedback;
        const msg = document.getElementById("feedback-msg")!;
        msg.classList.remove("hidden");
        if (value === "yes") {
          msg.textContent = "Danke für dein Feedback.";
        } else {
          msg.innerHTML = `Schade — <a href="#" data-open-chat class="underline">frag Sandy im Chat</a> oder schreib uns an <a href="mailto:office@salesagent.at" class="underline">office@salesagent.at</a>.`;
        }
      });
    });

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-open-chat]")) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("sandy:open"));
      }
    });
  </script>

  <style>
    .reading-progress {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--color-gold-primary);
      transform: scaleX(0);
      transform-origin: 0 50%;
      z-index: 50;
      transition: transform 60ms linear;
      box-shadow: 0 0 12px var(--gold-glow);
    }
    .article-headline {
      font-weight: 600;
      letter-spacing: -0.035em;
      line-height: 1.05;
      font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    }
    .article-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 28px;
      width: 28px;
      border-radius: 6px;
      border: 1px solid var(--color-border-subtle);
      background: transparent;
      color: var(--color-text-tertiary);
      cursor: pointer;
      transition: all 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .article-icon-btn:hover {
      color: var(--color-gold-bright);
      border-color: var(--color-border-default);
      transform: translateY(-1px);
    }
    .article-bookmark.is-active {
      color: var(--color-gold-bright);
      border-color: var(--color-gold-primary);
      background: color-mix(in srgb, var(--color-gold-primary) 12%, transparent);
    }
    .article-bookmark.is-active svg { fill: currentColor; }
    .article-icon-btn.is-flash {
      color: var(--color-gold-bright);
      border-color: var(--color-gold-primary);
      background: color-mix(in srgb, var(--color-gold-primary) 18%, transparent);
    }
    .share-toast {
      position: fixed;
      left: 50%;
      bottom: 32px;
      transform: translateX(-50%) translateY(20px);
      padding: 0.6rem 1rem;
      border-radius: 8px;
      background: color-mix(in srgb, var(--color-bg-elevated) 96%, transparent);
      border: 1px solid var(--color-border-default);
      color: var(--color-text-primary);
      font-size: 0.85rem;
      box-shadow: 0 12px 36px -10px rgba(0,0,0,0.4);
      opacity: 0;
      pointer-events: none;
      z-index: 55;
      transition: opacity 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .share-toast.is-visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Scroll-Spy TOC */
    .toc-link {
      position: relative;
      padding-left: 14px;
      letter-spacing: -0.005em;
      transition: color 240ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .toc-link .toc-bar {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%) scaleY(0.4);
      transform-origin: 50% 50%;
      width: 2px;
      height: 16px;
      background: var(--color-border-default);
      border-radius: 2px;
      transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
                  background 280ms ease;
    }
    .toc-link:hover { color: var(--color-gold-bright); }
    .toc-link:hover .toc-bar { background: var(--color-gold-dim); transform: translateY(-50%) scaleY(0.7); }
    .toc-link.is-active {
      color: var(--color-text-primary);
      font-weight: 500;
    }
    .toc-link.is-active .toc-bar {
      background: var(--color-gold-primary);
      transform: translateY(-50%) scaleY(1.1);
    }
  </style>
</BaseLayout>
