---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Kontakt" description="Kontaktiere den SalesAgent-Support — per Chat oder Email.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <nav class="mb-6 flex items-center gap-2 text-xs" style="color: var(--color-text-tertiary);">
      <a href="/" class="hover:text-[var(--color-gold-bright)]">Hilfe</a>
      <span>/</span>
      <span style="color: var(--color-text-secondary);">Kontakt</span>
    </nav>

    <header class="reveal">
      <h1 class="h-display text-4xl sm:text-5xl" style="color: var(--color-text-primary);">Kontakt.</h1>
      <p class="mt-4 max-w-xl text-base" style="color: var(--color-text-secondary);">
        Schnellster Weg: <strong style="color: var(--color-text-primary);">Sandy</strong> im Chat. Sie löst die meisten Anliegen sofort. Wenn nicht — schreib uns direkt, wir melden uns innerhalb von 24 h an Werktagen.
      </p>
    </header>

    <div class="reveal reveal-delay-1 mt-10 rounded-md border p-8" style="border-color: var(--color-border-default); background: linear-gradient(135deg, rgba(191, 163, 124, 0.10) 0%, rgba(191, 163, 124, 0.02) 100%);">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-md" style="background: rgba(191, 163, 124, 0.15); border: 1px solid var(--color-border-default);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold-bright);">
            <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-semibold" style="color: var(--color-text-primary);">Mit Sandy chatten</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Antwortet sofort. Bei Bedarf eskaliert sie an unser Team.</p>
        </div>
        <button class="btn btn-primary" data-open-chat type="button">Chat öffnen</button>
      </div>
    </div>

    <div class="reveal reveal-delay-2 mt-4 card flex flex-wrap items-center justify-between gap-4 p-6">
      <div>
        <h3 class="text-base font-semibold" style="color: var(--color-text-primary);">Per Email</h3>
        <p class="mt-1 text-sm" style="color: var(--color-text-secondary);">Antwort innerhalb von 24 h an Werktagen.</p>
      </div>
      <a href="mailto:office@salesagent.at" class="font-mono text-sm transition-colors hover:text-[var(--color-gold-bright)]" style="color: var(--color-gold-light);">office@salesagent.at</a>
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-open-chat]").forEach((b) => {
      b.addEventListener("click", () => window.dispatchEvent(new CustomEvent("sandy:open")));
    });
  </script>
</BaseLayout>
