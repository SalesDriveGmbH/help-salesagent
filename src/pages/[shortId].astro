---
/**
 * Short-ID-Redirect: /a01, /v06, /t10 → /artikel/<cat>/<id>-<slug>
 * Auch /A01, /V06, /T10 (Case-insensitive) und /a-01 funktionieren.
 */
import { getCollection } from "astro:content";

export const prerender = false;

const raw = (Astro.params.shortId ?? "").toString();
const normalized = raw.replace(/[-\s_]/g, "").toUpperCase();

// Nur 2-5 Zeichen mit Buchstabe(n) + Zahl(en) durchlassen
if (!/^[A-Z]{1,2}\d{1,3}$/.test(normalized)) {
  return Astro.redirect("/404", 302);
}

const all = await getCollection("articles");
const hit = all.find((a) => a.data.id === normalized);

if (!hit) {
  return Astro.redirect("/404", 302);
}

const slug = hit.id.replace(/^[^/]+\//, "");
return Astro.redirect(`/artikel/${hit.data.category}/${slug}`, 302);
---
