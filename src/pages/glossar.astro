---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { GLOSSARY } from "../lib/glossary";

const entries = Object.entries(GLOSSARY).sort(([a], [b]) => a.localeCompare(b, "de"));
---

<BaseLayout title="Glossar" description="Alle Fachbegriffe und Abkürzungen aus dem SalesAgent-Hilfebereich auf einen Blick.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-24">
    <nav class="mb-6 flex items-center gap-2 text-xs" style="color: var(--color-text-tertiary);">
      <a href="/" class="hover:text-[var(--color-gold-bright)]">Hilfe</a>
      <span>/</span>
      <span style="color: var(--color-text-secondary);">Glossar</span>
    </nav>

    <header class="reveal">
      <p class="text-[11px] uppercase tracking-[0.22em]" style="color: var(--color-gold-dim);">Begriffe & Abkürzungen</p>
      <h1 class="glossar-headline mt-4" style="color: var(--color-text-primary);">
        Glossar<span style="color: var(--color-gold-bright);">.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-base sm:text-lg" style="color: var(--color-text-secondary);">
        Was bedeutet HVV, PNV oder Reverse Charge? Hier sind alle Begriffe, die in der Wissensdatenbank vorkommen, kurz erklärt.
      </p>
    </header>

    <div class="reveal reveal-delay-1 mt-8">
      <input id="glossar-search" type="search" placeholder="Begriff suchen …" autocomplete="off" class="input" style="height: 48px;" />
    </div>

    <div class="reveal reveal-delay-2 mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {entries.map(([term, def]) => (
        <article class="glossar-card card p-5" data-term={term.toLowerCase()} data-def={def.toLowerCase()}>
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-base font-semibold" style="color: var(--color-gold-light); letter-spacing: 0.02em;">{term}</span>
          </div>
          <p class="mt-2 text-sm" style="color: var(--color-text-secondary); line-height: 1.55;">{def}</p>
        </article>
      ))}
    </div>

    <div id="glossar-empty" hidden class="mt-12 text-center" style="color: var(--color-text-tertiary);">
      Kein Begriff passt zur Suche.
    </div>
  </section>

  <style>
    .glossar-headline {
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1;
      font-size: clamp(2.5rem, 7vw, 4.5rem);
    }
  </style>

  <script>
    const input = document.getElementById("glossar-search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".glossar-card"));
    const empty = document.getElementById("glossar-empty");
    if (input && cards.length) {
      input.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const c of cards) {
          const hit = !q || (c.dataset.term ?? "").includes(q) || (c.dataset.def ?? "").includes(q);
          c.style.display = hit ? "" : "none";
          if (hit) visible++;
        }
        if (empty) empty.toggleAttribute("hidden", visible !== 0);
      });
    }
  </script>
</BaseLayout>
