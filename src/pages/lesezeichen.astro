---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("articles");
const articleData = all.map((a) => ({
  id: a.data.id,
  title: a.data.title,
  category: a.data.category,
  slug: a.id.replace(/^[^/]+\//, ""),
  tldr: a.data.tldr ?? "",
  status: a.data.status,
  last_updated: a.data.last_updated,
}));

// Top-3 populäre Artikel als Empty-State-Vorschläge
const suggestions = [...all]
  .filter((a) => a.data.status === "complete")
  .sort((a, b) => (a.data.faq_priority ?? 50) - (b.data.faq_priority ?? 50))
  .slice(0, 3)
  .map((a) => ({
    id: a.data.id,
    title: a.data.title,
    category: a.data.category,
    slug: a.id.replace(/^[^/]+\//, ""),
    tldr: a.data.tldr ?? "",
  }));
---

<BaseLayout title="Lesezeichen" description="Deine gemerkten Artikel im SalesAgent-Hilfebereich.">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-24">
    <nav class="mb-6 flex items-center gap-2 text-xs" style="color: var(--color-text-tertiary);">
      <a href="/" class="hover:text-[var(--color-gold-bright)]">Hilfe</a>
      <span>/</span>
      <span style="color: var(--color-text-secondary);">Lesezeichen</span>
    </nav>

    <header class="reveal">
      <p class="text-[11px] uppercase tracking-[0.22em]" style="color: var(--color-gold-dim);">Privat · lokal gespeichert</p>
      <h1 class="lesezeichen-headline mt-4" style="color: var(--color-text-primary);">
        Deine Lesezeichen<span style="color: var(--color-gold-bright);">.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-base sm:text-lg" style="color: var(--color-text-secondary);">
        Hier landen alle Artikel, die du dir gemerkt hast. Speicherort ist dein Browser — wir sehen die Liste nicht.
      </p>
    </header>

    <div id="streak-mount" class="mt-10"></div>
    <div id="bookmarks-mount" class="mt-8"></div>

    <template id="bookmark-tpl">
      <a class="bm-item card group block p-5">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">
            <span class="bm-id font-mono"></span>
            <span>·</span>
            <span class="bm-cat"></span>
          </div>
          <button class="bm-remove" type="button" title="Entfernen" aria-label="Lesezeichen entfernen">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <div class="bm-title mt-2 text-base font-semibold transition-colors group-hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-primary); letter-spacing: -0.015em;"></div>
        <div class="bm-tldr mt-1 text-sm" style="color: var(--color-text-secondary);"></div>
      </a>
    </template>
  </section>

  <style>
    .lesezeichen-headline {
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1;
      font-size: clamp(2.5rem, 7vw, 4.5rem);
    }
    .bm-empty {
      text-align: center;
      padding: 3rem 1rem;
      border-radius: 12px;
      border: 1px dashed var(--color-border-default);
      background: color-mix(in srgb, var(--color-bg-elevated) 40%, transparent);
    }
    .bm-remove {
      width: 26px;
      height: 26px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: 1px solid var(--color-border-subtle);
      background: transparent;
      color: var(--color-text-tertiary);
      cursor: pointer;
      transition: all 160ms ease;
    }
    .bm-remove:hover {
      color: #E3A66A;
      border-color: rgba(227, 166, 106, 0.3);
    }
  </style>

  <script is:inline define:vars={{ articleData, suggestions }}>
    (function () {
      const BOOKMARK_KEY = "sd:bookmarks";
      const CATEGORY_LABEL = {
        abrechnung: "Abrechnung", technik: "Technik", projekt: "Projekte",
        vertrag: "Vertrag", ausbildung: "Ausbildung", community: "Community",
      };
      const mount = document.getElementById("bookmarks-mount");
      const tpl = document.getElementById("bookmark-tpl");
      const streakMount = document.getElementById("streak-mount");
      if (streakMount) {
        try {
          const s = JSON.parse(localStorage.getItem("sd:streak") || '{"days":0,"last":""}');
          if (s.days >= 1) {
            const flame = s.days >= 7 ? "🔥" : s.days >= 3 ? "⭐" : "✨";
            streakMount.innerHTML = `
              <div class="streak-card">
                <div class="streak-emoji">${flame}</div>
                <div class="flex-1">
                  <div class="streak-num">${s.days} ${s.days === 1 ? "Tag" : "Tage"}</div>
                  <div class="streak-hint">aufeinanderfolgendes Lernen — bleib dran!</div>
                </div>
              </div>
              <style>
                .streak-card {
                  display: flex; align-items: center; gap: 16px;
                  padding: 20px;
                  border-radius: 12px;
                  border: 1px solid var(--color-border-default);
                  background: linear-gradient(135deg, rgba(191,163,124,0.10) 0%, rgba(191,163,124,0.02) 100%);
                }
                .streak-emoji { font-size: 2.5rem; }
                .streak-num {
                  font-size: 1.25rem;
                  font-weight: 600;
                  letter-spacing: -0.02em;
                  color: var(--color-text-primary);
                }
                .streak-hint {
                  font-size: 0.85rem;
                  color: var(--color-text-secondary);
                  margin-top: 2px;
                }
              </style>
            `;
          }
        } catch {}
      }
      if (!mount || !tpl) return;

      function load() {
        try { return JSON.parse(localStorage.getItem(BOOKMARK_KEY) || "[]"); } catch { return []; }
      }
      function save(arr) {
        try { localStorage.setItem(BOOKMARK_KEY, JSON.stringify(arr)); } catch {}
      }

      function render() {
        const ids = load();
        mount.innerHTML = "";
        const found = ids
          .map((id) => articleData.find((a) => a.id === id))
          .filter(Boolean);
        if (found.length === 0) {
          const suggestionHtml = (suggestions || []).map((a) => `
            <a href="/artikel/${a.category}/${a.slug}" class="bm-suggest">
              <div class="bm-suggest__id">${a.id}</div>
              <div class="bm-suggest__title">${a.title}</div>
              ${a.tldr ? `<div class="bm-suggest__tldr">${a.tldr}</div>` : ""}
            </a>
          `).join("");
          mount.innerHTML = `
            <div class="bm-empty">
              <div class="bm-empty__icon" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold-dim);">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                </svg>
              </div>
              <p style="color: var(--color-text-primary); font-size: 1.05rem; font-weight: 500;">
                Noch keine Lesezeichen
              </p>
              <p class="mt-2 text-sm" style="color: var(--color-text-tertiary);">
                Klick auf einer Artikel-Seite oben rechts auf das Stern-Icon — der Artikel landet dann hier.
              </p>
            </div>
            ${suggestions && suggestions.length ? `
              <div class="mt-10">
                <div class="text-[10px] uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Empfohlene Einstiege</div>
                <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
                  ${suggestionHtml}
                </div>
              </div>
            ` : ""}
            <style>
              .bm-empty__icon {
                width: 56px; height: 56px;
                margin: 0 auto 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                border: 1px solid var(--color-border-subtle);
                background: color-mix(in srgb, var(--color-gold-primary) 8%, transparent);
              }
              .bm-suggest {
                display: block;
                padding: 14px 16px;
                border-radius: 10px;
                border: 1px solid var(--color-border-subtle);
                background: color-mix(in srgb, var(--color-bg-elevated) 60%, transparent);
                transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
              }
              :root[data-theme="light"] .bm-suggest { background: #FFFFFF; }
              .bm-suggest:hover {
                border-color: var(--color-border-default);
                transform: translateY(-1px);
              }
              .bm-suggest__id {
                font-family: var(--font-mono);
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.16em;
                color: var(--color-text-tertiary);
              }
              .bm-suggest__title {
                margin-top: 4px;
                font-size: 0.9rem;
                font-weight: 500;
                color: var(--color-text-primary);
              }
              .bm-suggest:hover .bm-suggest__title { color: var(--color-gold-bright); }
              .bm-suggest__tldr {
                margin-top: 4px;
                font-size: 0.78rem;
                color: var(--color-text-secondary);
                line-height: 1.45;
              }
            </style>
          `;
          return;
        }
        const frag = document.createDocumentFragment();
        for (const a of found) {
          const node = tpl.content.cloneNode(true);
          const link = node.querySelector(".bm-item");
          link.setAttribute("href", `/artikel/${a.category}/${a.slug}`);
          node.querySelector(".bm-id").textContent = a.id;
          node.querySelector(".bm-cat").textContent = CATEGORY_LABEL[a.category] || a.category;
          node.querySelector(".bm-title").textContent = a.title;
          const tldr = node.querySelector(".bm-tldr");
          if (a.tldr) tldr.textContent = a.tldr;
          else tldr.remove();
          const removeBtn = node.querySelector(".bm-remove");
          removeBtn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const next = load().filter((id) => id !== a.id);
            save(next);
            render();
          });
          frag.appendChild(node);
        }
        const list = document.createElement("div");
        list.className = "grid grid-cols-1 gap-3 sm:grid-cols-2";
        list.appendChild(frag);
        mount.appendChild(list);
      }
      render();
    })();
  </script>
</BaseLayout>
