---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/public/SearchBar.astro";
import CategoryGrid from "../components/public/CategoryGrid.astro";
import ArticleCard from "../components/public/ArticleCard.astro";
import { getCollection } from "astro:content";

const all = await getCollection("articles");
const FEATURED_IDS = ["A01", "A02", "A03"];
const featured = FEATURED_IDS
  .map((id) => all.find((a) => a.data.id === id))
  .filter(Boolean) as typeof all;

function slugOf(entry: typeof all[number]) {
  return entry.id.replace(/^[^/]+\//, "");
}
---

<BaseLayout title="Hilfe & Antworten — SalesAgent" description="Hilfebereich für SalesAgents von SalesDrive. Antworten zu Abrechnung, Onboarding, Verträgen und Tools.">
  <section class="relative mx-auto max-w-6xl px-6 pt-20 pb-14 sm:pt-28 sm:pb-20">
    <div class="reveal max-w-3xl">
      <p class="text-xs uppercase tracking-[0.18em]" style="color: var(--color-gold-dim);">SalesAgent · Hilfebereich</p>
      <h1 class="h-display mt-4 text-5xl sm:text-7xl" style="color: var(--color-text-primary);">
        Frag Sandy<span style="color: var(--color-gold-bright);">.</span>
      </h1>
      <p class="mt-5 max-w-xl text-base sm:text-lg" style="color: var(--color-text-secondary);">
        Deine AI-Assistentin beantwortet alle Fragen rund um Abrechnung, Onboarding, Tools und Vertrag — sofort, rund um die Uhr.
      </p>
    </div>

    <div class="reveal reveal-delay-1 mt-10 flex flex-wrap items-center gap-3">
      <button class="hero-chat-cta" data-open-chat type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z" />
        </svg>
        Chat öffnen
      </button>
      <span class="text-xs" style="color: var(--color-text-tertiary);">oder lies unten nach</span>
    </div>

    <div class="reveal reveal-delay-2 mt-12 max-w-2xl">
      <p class="mb-3 text-xs uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">Suchen</p>
      <SearchBar size="lg" />
      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs" style="color: var(--color-text-tertiary);">
        <span class="mr-1">Beliebt:</span>
        {["Auszahlung", "Konversionsrate", "Kontoblatt", "Einsendeschluss"].map((q) => (
          <button class="rounded-full border px-2.5 py-1 transition-colors hover:text-[var(--color-gold-bright)]" style="border-color: var(--color-border-subtle);" data-quick={q} type="button">{q}</button>
        ))}
      </div>
    </div>
  </section>

  <style>
    .hero-chat-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.95rem 1.6rem;
      border-radius: 8px;
      background: var(--color-gold-primary);
      color: #FFFFFF;
      border: 1px solid var(--color-gold-primary);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      cursor: pointer;
      transition: background 180ms ease, transform 180ms ease, box-shadow 220ms ease;
      box-shadow: 0 0 0 1px var(--color-border-subtle), 0 12px 32px -10px rgba(0, 0, 0, 0.4), 0 0 60px var(--gold-glow);
    }
    :root:not([data-theme="light"]) .hero-chat-cta { color: #050505; }
    .hero-chat-cta:hover {
      background: var(--color-gold-bright);
      border-color: var(--color-gold-bright);
      transform: translateY(-1px);
    }
  </style>

  <script>
    document.querySelectorAll("[data-open-chat]").forEach((b) => {
      b.addEventListener("click", () => window.dispatchEvent(new CustomEvent("sandy:open")));
    });
  </script>

  <div class="divider-gold mx-auto max-w-6xl"></div>

  <section class="mx-auto max-w-6xl px-6 py-14">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="h-display text-xl sm:text-2xl" style="color: var(--color-text-primary); letter-spacing: -0.03em;">Häufig gesucht</h2>
      <span class="text-xs uppercase tracking-[0.14em]" style="color: var(--color-text-tertiary);">Abrechnung</span>
    </div>
    <div class="reveal reveal-delay-3 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {featured.map((a) => (
        <ArticleCard
          href={`/artikel/${a.data.category}/${slugOf(a)}`}
          id={a.data.id}
          title={a.data.title}
          tldr={a.data.tldr}
          status={a.data.status}
        />
      ))}
    </div>
  </section>

  <div class="divider-gold mx-auto max-w-6xl"></div>

  <section class="mx-auto max-w-6xl px-6 py-14 pb-24">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="h-display text-xl sm:text-2xl" style="color: var(--color-text-primary); letter-spacing: -0.03em;">Themen</h2>
      <a href="/kontakt" class="text-xs uppercase tracking-[0.14em] hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-tertiary);">Kontakt</a>
    </div>
    <div class="reveal reveal-delay-4">
      <CategoryGrid />
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-quick]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const q = (btn as HTMLElement).dataset.quick ?? "";
        const input = document.getElementById("kb-search") as HTMLInputElement | null;
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event("input", { bubbles: true }));
          input.focus();
        }
      });
    });
  </script>
</BaseLayout>
