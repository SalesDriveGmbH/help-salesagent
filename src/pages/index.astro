---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/public/SearchBar.astro";
import CategoryGrid from "../components/public/CategoryGrid.astro";
import ArticleCard from "../components/public/ArticleCard.astro";
import { getCollection } from "astro:content";

const all = await getCollection("articles");
const FEATURED_IDS = ["A01", "A02", "A03"];
const featured = FEATURED_IDS
  .map((id) => all.find((a) => a.data.id === id))
  .filter(Boolean) as typeof all;

function slugOf(entry: typeof all[number]) {
  return entry.id.replace(/^[^/]+\//, "");
}

// 3 zuletzt aktualisierte Artikel mit Status complete (Banner)
const recent = [...all]
  .filter((a) => a.data.status === "complete")
  .sort((a, b) => (b.data.last_updated ?? "").localeCompare(a.data.last_updated ?? ""))
  .slice(0, 3);
---

<BaseLayout title="Hilfe & Antworten — SalesAgent" description="Hilfebereich für SalesAgents von SalesDrive. Antworten zu Abrechnung, Onboarding, Verträgen und Tools.">
  <section class="relative mx-auto max-w-6xl px-6 pt-24 pb-14 sm:pt-36 sm:pb-24">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="reveal max-w-4xl relative">
      <p class="text-[11px] uppercase tracking-[0.22em]" style="color: var(--color-gold-dim);">SalesAgent · Hilfebereich</p>
      <h1 class="hero-headline mt-6" style="color: var(--color-text-primary);">
        <span class="hero-rotate" aria-live="polite">
          <span class="hero-rotate__word is-active">Frag Sandy</span>
          <span class="hero-rotate__word">Find Antworten</span>
          <span class="hero-rotate__word">Lerne schneller</span>
        </span><span style="color: var(--color-gold-bright);">.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg sm:text-xl" style="color: var(--color-text-secondary); letter-spacing: -0.012em; line-height: 1.5;">
        Deine AI-Assistentin beantwortet alle Fragen rund um Abrechnung, Onboarding, Tools und Vertrag — sofort, rund um die Uhr.
      </p>
    </div>

    <div class="reveal reveal-delay-1 mt-12 flex flex-wrap items-center gap-3">
      <button class="hero-chat-cta" data-open-chat type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z" />
        </svg>
        Chat öffnen
      </button>
      <button class="hero-search-cta" data-search-open type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/>
        </svg>
        Durchsuchen
        <kbd class="kbd-hero">⌘K</kbd>
      </button>
    </div>

    <div class="reveal reveal-delay-2 mt-5 flex flex-wrap items-center gap-2 text-xs" style="color: var(--color-text-tertiary);">
      <span class="mr-1">Beliebt:</span>
      {["Auszahlung", "Konversionsrate", "Kontoblatt", "Einsendeschluss"].map((q) => (
        <button class="rounded-full border px-3 py-1.5 transition-colors hover:text-[var(--color-gold-bright)] hover:border-[var(--color-border-strong)]" style="border-color: var(--color-border-subtle);" data-quick={q} type="button">{q}</button>
      ))}
    </div>
  </section>

  <style>
    .hero-headline {
      font-weight: 600;
      letter-spacing: -0.045em;
      line-height: 0.95;
      font-size: clamp(3.5rem, 11vw, 8.5rem);
    }
    .hero-chat-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 1rem 1.75rem;
      border-radius: 8px;
      background: var(--color-gold-primary);
      color: #FFFFFF;
      border: 1px solid var(--color-gold-primary);
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      cursor: pointer;
      transition: background 220ms cubic-bezier(0.22, 1, 0.36, 1),
                  transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 0 1px var(--color-border-subtle), 0 14px 40px -10px rgba(0, 0, 0, 0.45), 0 0 80px var(--gold-glow);
    }
    :root:not([data-theme="light"]) .hero-chat-cta { color: #050505; }
    .hero-chat-cta:hover {
      background: var(--color-gold-bright);
      border-color: var(--color-gold-bright);
      transform: translateY(-2px);
      box-shadow: 0 0 0 1px var(--color-border-subtle), 0 22px 50px -12px rgba(0, 0, 0, 0.5), 0 0 100px var(--gold-glow);
    }
    .hero-search-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 1rem 1.5rem;
      border-radius: 8px;
      background: transparent;
      color: var(--color-text-secondary);
      border: 1px solid var(--color-border-default);
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      cursor: pointer;
      transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hero-search-cta:hover {
      color: var(--color-text-primary);
      border-color: var(--color-border-strong);
      transform: translateY(-1px);
    }
    .kbd-hero {
      margin-left: 0.4rem;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      border: 1px solid var(--color-border-default);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-text-tertiary);
    }

    /* Rotating Hero-Words */
    .hero-rotate {
      display: inline-block;
      position: relative;
      vertical-align: top;
      min-height: 1em;
    }
    .hero-rotate__word {
      display: inline-block;
      position: absolute;
      top: 0;
      left: 0;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(0.18em);
      transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1),
                  transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hero-rotate__word.is-active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
    }
    .hero-rotate__word.is-leaving {
      opacity: 0;
      transform: translateY(-0.18em);
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-rotate__word { transition: none; }
    }

    /* Subtiler animierter Glow-Orb hinterm Hero */
    .hero-orb {
      position: absolute;
      top: 18%;
      left: 25%;
      width: 32vw;
      height: 32vw;
      max-width: 540px;
      max-height: 540px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
      background: radial-gradient(circle, color-mix(in srgb, var(--color-gold-primary) 22%, transparent) 0%, transparent 65%);
      filter: blur(80px);
      animation: hero-orb-drift 14s ease-in-out infinite alternate;
      opacity: 0.7;
    }
    :root[data-theme="light"] .hero-orb { opacity: 0.45; }
    @keyframes hero-orb-drift {
      0%   { transform: translate(0, 0) scale(1); }
      50%  { transform: translate(4vw, -2vw) scale(1.08); }
      100% { transform: translate(-2vw, 3vw) scale(0.95); }
    }
    @media (prefers-reduced-motion: reduce) { .hero-orb { animation: none; } }

    /* Recent-Updates-Banner */
    .recent-banner {
      border-color: var(--color-border-default);
      background: linear-gradient(135deg, rgba(191, 163, 124, 0.06) 0%, rgba(191, 163, 124, 0.01) 100%);
    }
    .recent-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-gold-primary);
      box-shadow: 0 0 0 0 rgba(191, 163, 124, 0.6);
      animation: recent-pulse 2.4s ease-in-out infinite;
    }
    @keyframes recent-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(191, 163, 124, 0.5); }
      50%      { box-shadow: 0 0 0 6px rgba(191, 163, 124, 0); }
    }
    .recent-item {
      border: 1px solid transparent;
      transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .recent-item:hover {
      border-color: var(--color-border-default);
      background: color-mix(in srgb, var(--color-bg-hover) 60%, transparent);
      transform: translateY(-1px);
    }
    @media (prefers-reduced-motion: reduce) {
      .recent-dot { animation: none; }
    }
  </style>

  <script>
    document.querySelectorAll("[data-open-chat]").forEach((b) => {
      b.addEventListener("click", () => window.dispatchEvent(new CustomEvent("sandy:open")));
    });
    document.querySelectorAll("[data-search-open]").forEach((b) => {
      b.addEventListener("click", () => window.dispatchEvent(new CustomEvent("palette:open")));
    });
    // Beliebt-Buttons: öffnen Palette mit Voreingabe
    document.querySelectorAll("[data-quick]").forEach((b) => {
      b.addEventListener("click", () => {
        const q = (b as HTMLElement).dataset.quick ?? "";
        window.dispatchEvent(new CustomEvent("palette:open-with-query", { detail: { query: q } }));
      });
    });

    // Rotating Hero-Words
    (function () {
      const words = Array.from(document.querySelectorAll<HTMLSpanElement>(".hero-rotate__word"));
      if (words.length <= 1) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      let active = 0;
      setInterval(() => {
        const cur = words[active];
        const next = words[(active + 1) % words.length];
        cur.classList.remove("is-active");
        cur.classList.add("is-leaving");
        // Längste Wort-Breite halten via position:absolute on cur; next wird wieder relativ
        next.classList.add("is-active");
        setTimeout(() => { cur.classList.remove("is-leaving"); }, 800);
        active = (active + 1) % words.length;
      }, 3800);
    })();
  </script>

  <div class="divider-gold mx-auto max-w-6xl"></div>

  <section class="mx-auto max-w-6xl px-6 pt-12">
    <div class="reveal recent-banner rounded-md border p-5 sm:p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="recent-dot" aria-hidden="true"></span>
          <h2 class="text-sm font-semibold uppercase tracking-[0.16em]" style="color: var(--color-gold-light);">Frisch aktualisiert</h2>
        </div>
        <a href="/kategorie/abrechnung" class="text-xs uppercase tracking-[0.14em] hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-tertiary);">Alle Updates</a>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
        {recent.map((a) => (
          <a href={`/artikel/${a.data.category}/${slugOf(a)}`} class="recent-item group block rounded-md p-3">
            <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.16em]" style="color: var(--color-text-tertiary);">
              <span class="font-mono">{a.data.id}</span>
              <span>·</span>
              <span>{a.data.last_updated}</span>
            </div>
            <div class="mt-1 text-sm font-medium transition-colors group-hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-primary);">{a.data.title}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-14">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="h-display text-xl sm:text-2xl" style="color: var(--color-text-primary); letter-spacing: -0.03em;">Häufig gesucht</h2>
      <span class="text-xs uppercase tracking-[0.14em]" style="color: var(--color-text-tertiary);">Abrechnung</span>
    </div>
    <div class="reveal reveal-delay-3 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {featured.map((a) => (
        <ArticleCard
          href={`/artikel/${a.data.category}/${slugOf(a)}`}
          id={a.data.id}
          title={a.data.title}
          tldr={a.data.tldr}
          status={a.data.status}
          lastUpdated={a.data.last_updated}
        />
      ))}
    </div>
  </section>

  <div class="divider-gold mx-auto max-w-6xl"></div>

  <section class="mx-auto max-w-6xl px-6 py-14 pb-24">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="h-display text-xl sm:text-2xl" style="color: var(--color-text-primary); letter-spacing: -0.03em;">Themen</h2>
      <a href="/kontakt" class="text-xs uppercase tracking-[0.14em] hover:text-[var(--color-gold-bright)]" style="color: var(--color-text-tertiary);">Kontakt</a>
    </div>
    <div class="reveal reveal-delay-4">
      <CategoryGrid />
    </div>
  </section>

</BaseLayout>
