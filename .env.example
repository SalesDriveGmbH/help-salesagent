# Anthropic — Claude API
ANTHROPIC_API_KEY=

# Intercom — Conversations API
INTERCOM_ACCESS_TOKEN=
INTERCOM_ADMIN_ID=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel KV (auto-injected von Vercel)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Admin
# Komma-getrennte Liste autorisierter Email-Adressen für /admin Zugang.
# Magic-Link-Login funktioniert nur für Adressen aus dieser Liste.
ADMIN_ALLOWED_EMAILS=office@salesdrive.at
SESSION_SECRET=

# Resend (Magic-Link Email-Versand)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@help.salesdrive.at

# GitHub API (Commits für KB-Updates)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=SalesDriveGmbH
GITHUB_REPO_NAME=help-salesagent

# Site
PUBLIC_SITE_URL=https://help.salesdrive.at
